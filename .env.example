# Ariadne — 服务端 env 占位（**不要填真值提交**；本文件只列名字）
#
# Next 只读 app 目录：复制为 apps/web/.env.local（已被 apps/web/.gitignore 忽略），
# 或在 shell 里 export 后再 `pnpm dev` / `pnpm build && pnpm start`。
# 禁止 NEXT_PUBLIC_* 前缀——钥只在服务端。

# ---- T66 Clew 只读小能力（一档即可；两钥都在时 CLEW_PROVIDER 指定，缺省 Zhipu 优先）----
ZHIPU_API_KEY=
# ZHIPU_MODEL=glm-4.5-flash
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MINIMAX_API_KEY=
# MINIMAX_MODEL=MiniMax-M2
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# CLEW_PROVIDER=zhipu   # 或 minimax；显式指定但缺对应钥 → 503（不悄换）

# ---- 既有：extract_cards.mjs 直连（与 Clew 无关，各管各）----
# GLM_API_KEY=
# DEEPSEEK_API_KEY=
# ARIADNE_DATA=   # 覆盖仓库根 config/ + data/ 路径（部署用）
