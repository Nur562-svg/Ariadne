# Ariadne — 服务端 env 占位（**不要填真值提交**；本文件只列名字）
#
# Next 只读 app 目录：复制为 apps/web/.env.local（已被 apps/web/.gitignore 忽略），
# 或在 shell 里 export 后再 `pnpm dev` / `pnpm build && pnpm start`。
# 禁止 NEXT_PUBLIC_* 前缀——钥只在服务端。

# ---- T66/T68 Clew 只读小能力 · 三档（Fast / Reasoning / Long-context）----
# 钥（两档共用钥池；只在服务端）：
ZHIPU_API_KEY=
MINIMAX_API_KEY=
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1     # 国际站 https://api.minimax.io/v1
#
# 档厂商（可选）：CLEW_<TIER>_PROVIDER > CLEW_PROVIDER > 缺省 Zhipu 优先。
# 铁规则：指定厂商缺钥 → 该档 503，**不**悄换另一档/另一厂商。
# CLEW_PROVIDER=zhipu                 # 或 minimax（全局缺省厂商）
# CLEW_FAST_PROVIDER=zhipu
# CLEW_REASONING_PROVIDER=zhipu
# CLEW_LONG_PROVIDER=zhipu
#
# 档模型（可选；缺省见 apps/web/lib/clew-provider.ts TIER_DEFAULT_MODELS）：
# CLEW_FAST_MODEL=glm-4.5-flash       # 快答 · 缺省默认档
# CLEW_REASONING_MODEL=glm-4.6        # 推理
# CLEW_LONG_MODEL=glm-4.6             # 长上下文
#
# 本机自设顶（可选；正整数；各档共用计数；今日 ≥ 顶 → 429；明日自动恢复；非云端额度墙）：
# CLEW_SESSION_MAX_CALLS=

# ---- 既有：extract_cards.mjs 直连（与 Clew 无关，各管各）----
# GLM_API_KEY=
# DEEPSEEK_API_KEY=
# ARIADNE_DATA=   # 覆盖仓库根 config/ + data/ 路径（部署用）
